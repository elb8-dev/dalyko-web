---
import Base from '../layouts/Base.astro';
const bloques = [
  { t: 'Lenguajes', v: 'TypeScript · JavaScript (ES6+) · Python · C# · Java · SQL' },
  { t: 'Front-end', v: 'React (Vite) · Astro · HTML5 · CSS3 · WordPress · PrestaShop · WooCommerce' },
  { t: 'Back-end y datos', v: 'PostgreSQL · API REST y webhooks · Node.js · Docker' },
  { t: 'Nube e infraestructura', v: 'Google Cloud Run · contenedores · despliegue continuo' },
  { t: 'Herramientas', v: 'Git y GitHub · Jira · ClickUp · GitHub Copilot e IA aplicada' },
];
const experiencia = [
  { p: 'Director de Operaciones — Transformación digital', o: 'Asset Lighthouse', f: '2024 – 2025', d: 'Dirección técnica y funcional de la digitalización: selección de plataformas, especificación de requisitos, coordinación de proveedores y despliegue. Equipo de 10 personas.' },
  { p: 'Fundador y director general', o: 'Zion Iber Group Ltd.', f: '2022 – 2024', d: 'Comercio internacional: tienda en línea, modelo de datos de costes y control documental.' },
  { p: 'Consultor de empresa y transformación digital', o: 'Velucia Iber Group S.L.U.', f: '2014 – 2021', d: 'Digitalización integral de negocios: desarrollo web, comercio electrónico y estrategia. Equipo de 4 personas.' },
  { p: 'Abogado — ejercicio por cuenta propia', o: 'ICAM 108020', f: '2013 – actualidad', d: 'Contratación, cumplimiento normativo y protección de datos, en paralelo a la actividad técnica.' },
];
---
<Base
  titulo="CV — Eloy R. Becerra Daly"
  descripcion="Currículum: desarrollo web, migraciones de sistemas e integraciones. Descarga en PDF."
>
  <p class="eyebrow">Currículum</p>
  <h1>CV</h1>
  <p class="lede">
    Versión completa en PDF, o el resumen aquí abajo.
    <a href="/CV-Eloy-Becerra-Daly.pdf" download>Descargar PDF →</a>
  </p>

  <h2>Stack</h2>
  <div class="pila">
    {bloques.map((b) => (
      <div class="tarjeta"><h3 style="margin-top:0">{b.t}</h3><p style="margin:0">{b.v}</p></div>
    ))}
  </div>

  <h2>Experiencia</h2>
  <div class="pila">
    {experiencia.map((e) => (
      <div>
        <h3 style="margin-bottom:.2rem">{e.p}</h3>
        <p class="meta" style="margin:0 0 .4rem">{e.o} · {e.f}</p>
        <p style="margin:0">{e.d}</p>
      </div>
    ))}
  </div>

  <h2>Formación</h2>
  <ul>
    <li>Gestión de proyectos con metodologías ágiles y enfoque Lean (Scrum y Kanban) — LABORA, Generalitat Valenciana, 2024</li>
    <li>Introducción a la Ciberseguridad — Cisco Networking Academy, 2025</li>
    <li>Máster en Dirección de Comercio Internacional — CTO Business Excellence School</li>
    <li>Licenciatura en Derecho — Universidad Complutense de Madrid</li>
  </ul>

  <h2>Idiomas</h2>
  <p>Español nativo · Inglés nativo (documentación técnica sin fricción).</p>
</Base>
