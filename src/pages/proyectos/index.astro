---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const ref = Astro.url.searchParams.get('ref');
const enlace = (href: string) => (ref ? `${href}?ref=${encodeURIComponent(ref)}` : href);

const proyectos = (await getCollection('proyectos')).sort((a, b) => a.data.orden - b.data.orden);
---

<Base
  titulo="Proyectos — Eloy R. Becerra Daly"
  descripcion="Sistemas construidos y migraciones ejecutadas: trading algorítmico, migración de CRM con 45.000 leads, plataforma web en 14 idiomas y cadena de suministro internacional."
>
  <p class="eyebrow">Proyectos</p>
  <h1>Lo que he construido</h1>
  <p class="lede">
    Cada ficha describe el problema, el enfoque y el resultado. Las cifras son
    las reales del proyecto.
  </p>

  <div class="pila">
    {proyectos.map((p) => (
      <article class="tarjeta">
        <h2 style="margin-top:0"><a href={enlace(`/proyectos/${p.id}`)}>{p.data.titulo}</a></h2>
        <p class="meta">
          {p.data.organizacion} · {p.data.periodo}
          {p.data.privado && <> · <em>repositorio privado</em></>}
        </p>
        <p>{p.data.resumen}</p>
        {p.data.metricas.length > 0 && (
          <p>
            {p.data.metricas.map((m) => (
              <span class="chip"><strong>{m.valor}</strong> {m.etiqueta}</span>
            ))}
          </p>
        )}
        <p>{p.data.stack.map((t) => <span class="chip">{t}</span>)}</p>
      </article>
    ))}
  </div>
</Base>
