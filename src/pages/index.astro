---
import '../styles/perfil.css';

const descripcion =
  'Eloy R. Becerra Daly — desarrollo, migraciones de sistemas y transformacion digital. ' +
  'Astro sobre Cloud Run, analitica sin cookies y proyectos con cifras reales.';
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://perfil.dalyko.com');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Eloy R. Becerra Daly',
  jobTitle: 'Desarrollador y consultor de transformacion digital',
  url: 'https://perfil.dalyko.com',
  email: 'mailto:daly@icam.es',
  telephone: '+34642568664',
  address: { '@type': 'PostalAddress', addressLocality: 'Pilar de la Horadada', addressRegion: 'Alicante', addressCountry: 'ES' },
  knowsLanguage: ['es', 'en'],
  sameAs: ['https://orcid.org/0009-0008-6684-6726', 'https://github.com/elb8-dev'],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Eloy R. Becerra Daly — Desarrollo y transformacion digital</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Eloy R. Becerra Daly" />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
<div style="background:var(--papel);min-height:100vh">

  <header style="position:sticky;top:0;z-index:40;background:rgba(252,250,245,.88);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border-bottom:1px solid var(--linea)">
    <div style="width:min(100% - 2.5rem,var(--ancho));margin-inline:auto;display:flex;flex-wrap:wrap;gap:1rem;align-items:center;justify-content:space-between;padding:.85rem 0">
      <a href="#perfil" style="display:flex;align-items:center;gap:.6rem;text-decoration:none">
        <span style="display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:var(--radio);background:var(--tinta);color:var(--papel);font-family:var(--fuente-mono);font-size:.7rem;letter-spacing:.02em">EB</span>
        <span style="font-family:var(--fuente-titulo);font-weight:700;color:var(--tinta);font-size:1.05rem">Eloy R. Becerra Daly</span>
      </a>
      <nav style="display:flex;align-items:center;gap:1.25rem">
        <a href="#proyectos" style="position:relative;text-decoration:none;font-size:.95rem;padding-bottom:.15rem">Proyectos<span style="position:absolute;left:0;right:0;bottom:-2px;height:2px;border-radius:2px;background:var(--laton);transition:opacity .25s ease;opacity:" data-style="position:absolute;left:0;right:0;bottom:-2px;height:2px;border-radius:2px;background:var(--laton);transition:opacity .25s ease;opacity:{navProyectos}"></span></a>
        <a href="#despliegue" style="position:relative;text-decoration:none;font-size:.95rem;padding-bottom:.15rem">Despliegue<span style="position:absolute;left:0;right:0;bottom:-2px;height:2px;border-radius:2px;background:var(--laton);transition:opacity .25s ease;opacity:" data-style="position:absolute;left:0;right:0;bottom:-2px;height:2px;border-radius:2px;background:var(--laton);transition:opacity .25s ease;opacity:{navDespliegue}"></span></a>
        <a href="#medicion" style="position:relative;text-decoration:none;font-size:.95rem;padding-bottom:.15rem">Medición<span style="position:absolute;left:0;right:0;bottom:-2px;height:2px;border-radius:2px;background:var(--laton);transition:opacity .25s ease;opacity:" data-style="position:absolute;left:0;right:0;bottom:-2px;height:2px;border-radius:2px;background:var(--laton);transition:opacity .25s ease;opacity:{navMedicion}"></span></a>
        <a href="#decisiones" style="position:relative;text-decoration:none;font-size:.95rem;padding-bottom:.15rem">Decisiones<span style="position:absolute;left:0;right:0;bottom:-2px;height:2px;border-radius:2px;background:var(--laton);transition:opacity .25s ease;opacity:" data-style="position:absolute;left:0;right:0;bottom:-2px;height:2px;border-radius:2px;background:var(--laton);transition:opacity .25s ease;opacity:{navDecisiones}"></span></a>
        <a href="#contacto" style="display:inline-flex;align-items:center;gap:.4rem;text-decoration:none;font-size:.9rem;border:1px solid var(--tinta);color:var(--tinta);border-radius:100px;padding:.3rem .85rem;transition:background .2s ease,color .2s ease" class="xed60119">Contacto
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
        </a>
      </nav>
    </div>
  </header>

  <main>

    <section id="perfil" style="width:min(100% - 2.5rem,var(--ancho));margin-inline:auto;padding:4.5rem 0 3rem">
      <div style="display:grid;gap:3rem;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);align-items:start">
        <div>
          <p style="font-size:.75rem;letter-spacing:.18em;text-transform:uppercase;color:var(--laton);font-weight:700;margin:0 0 .75rem">perfil.dalyko.com · Astro 7 SSR · Cloud Run</p>
          <h1 style="font-family:var(--fuente-titulo);color:var(--tinta);line-height:1.1;font-size:clamp(2.2rem,5.2vw,3.4rem);margin:0 0 1rem">Eloy R. Becerra&nbsp;Daly</h1>
          <p style="font-size:1.15rem;color:var(--tinta-2);margin:0 0 1.25rem;max-width:34rem">Desarrollo de software, integración de sistemas y despliegue en producción.</p>
          <p style="font-size:1.05rem;color:var(--texto-suave);max-width:40rem;margin:0 0 1.75rem;text-wrap:pretty">Este sitio <em>es</em> la muestra de trabajo. No es una plantilla: cada decisión —renderizado en servidor, contenido tipado, analítica sin cookies, contenedor endurecido y despliegue continuo— está tomada a propósito y explicada aquí.</p>
          <div style="display:flex;flex-wrap:wrap;gap:.6rem">
            <a href="#proyectos" style="display:inline-flex;align-items:center;gap:.45rem;text-decoration:none;background:var(--tinta);color:var(--papel);border-radius:100px;padding:.6rem 1.15rem;font-size:.95rem;transition:background .2s ease,transform .2s ease" class="x6d4f2d7">Ver proyectos
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
            </a>
            <a href="#despliegue" style="display:inline-flex;align-items:center;gap:.45rem;text-decoration:none;border:1px solid var(--linea);background:var(--papel-2);color:var(--tinta);border-radius:100px;padding:.6rem 1.15rem;font-size:.95rem;transition:border-color .2s ease" class="xc501318">Cómo se despliega</a>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:.4rem;margin-top:1.75rem">
            <span style="font-size:.75rem;font-family:var(--fuente-mono);border:1px solid var(--linea);border-radius:100px;padding:.15rem .6rem;color:var(--texto-suave)">TypeScript</span>
            <span style="font-size:.75rem;font-family:var(--fuente-mono);border:1px solid var(--linea);border-radius:100px;padding:.15rem .6rem;color:var(--texto-suave)">Python</span>
            <span style="font-size:.75rem;font-family:var(--fuente-mono);border:1px solid var(--linea);border-radius:100px;padding:.15rem .6rem;color:var(--texto-suave)">React</span>
            <span style="font-size:.75rem;font-family:var(--fuente-mono);border:1px solid var(--linea);border-radius:100px;padding:.15rem .6rem;color:var(--texto-suave)">C#</span>
            <span style="font-size:.75rem;font-family:var(--fuente-mono);border:1px solid var(--linea);border-radius:100px;padding:.15rem .6rem;color:var(--texto-suave)">PostgreSQL</span>
            <span style="font-size:.75rem;font-family:var(--fuente-mono);border:1px solid var(--linea);border-radius:100px;padding:.15rem .6rem;color:var(--texto-suave)">Docker</span>
            <span style="font-size:.75rem;font-family:var(--fuente-mono);border:1px solid var(--linea);border-radius:100px;padding:.15rem .6rem;color:var(--texto-suave)">Cloud Run</span>
            <span style="font-size:.75rem;font-family:var(--fuente-mono);border:1px solid var(--linea);border-radius:100px;padding:.15rem .6rem;color:var(--texto-suave)">API REST</span>
          </div>
        </div>

        <aside style="border:1px solid var(--panel-linea);border-radius:var(--radio);background:var(--panel);overflow:hidden">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:.75rem;padding:.6rem .85rem;border-bottom:1px solid var(--panel-linea);background:var(--panel-2)">
            <span style="display:inline-flex;align-items:center;gap:.5rem;font-family:var(--fuente-mono);font-size:.7rem;letter-spacing:.08em;text-transform:uppercase;color:var(--laton-claro)">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" x2="20" y1="19" y2="19"></line></svg>
              evento en curso
            </span>
            <span style="display:inline-flex;align-items:center;gap:.4rem;font-family:var(--fuente-mono);font-size:.68rem;color:var(--panel-suave)"><span style="width:6px;height:6px;border-radius:100px;background:#6ea87f;animation:latir 2s ease-in-out infinite"></span>stdout</span>
          </div>
          <pre style="margin:0;padding:.9rem .95rem;font-family:var(--fuente-mono);font-size:.72rem;line-height:1.75;color:var(--panel-texto);white-space:pre-wrap;word-break:break-word"><span style="color:var(--panel-suave)">&#123;</span>
  <span style="color:var(--laton-claro)">"tipo"</span>: "vista",
  <span style="color:var(--laton-claro)">"ruta"</span>: "/",
  <span style="color:var(--laton-claro)">"ref"</span>: <span data-t="refJson"></span>,
  <span style="color:var(--laton-claro)">"visitaId"</span>: "<span data-t="hash"></span>",
  <span style="color:var(--laton-claro)">"dispositivo"</span>: "<span data-t="dispositivo"></span>",
  <span style="color:var(--laton-claro)">"navegador"</span>: "<span data-t="navegador"></span>",
  <span style="color:var(--laton-claro)">"segundos"</span>: <span data-t="segundos"></span>,
  <span style="color:var(--laton-claro)">"scrollMax"</span>: <span data-t="scrollMax"></span><span style="display:inline-block;width:7px;height:1em;vertical-align:-2px;background:var(--laton);animation:cursor 1.1s step-end infinite"></span>
<span style="color:var(--panel-suave)">&#125;</span></pre>
          <p style="margin:0;padding:.7rem .95rem;border-top:1px solid var(--panel-linea);background:var(--panel-2);font-size:.75rem;line-height:1.5;color:var(--panel-suave)">Lo que este sitio registra de ti ahora mismo. Sin cookies, sin almacenamiento en tu navegador, sin guardar tu IP.</p>
        </aside>
      </div>

      <div data-reveal="" style="display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin-top:3.5rem;border-top:1px solid var(--linea);border-bottom:1px solid var(--linea)">
        <div style="padding:1.5rem 1.5rem 1.5rem 0">
          <div style="font-family:var(--fuente-titulo);color:var(--tinta);font-size:2rem;line-height:1">~5.000</div>
          <p style="margin:.35rem 0 0;font-size:.85rem;color:var(--texto-suave)">commits en el sistema de trading, 10 meses a dedicación casi completa</p>
        </div>
        <div style="padding:1.5rem;border-left:1px solid var(--linea)">
          <div style="font-family:var(--fuente-titulo);color:var(--tinta);font-size:2rem;line-height:1">~45.000</div>
          <p style="margin:.35rem 0 0;font-size:.85rem;color:var(--texto-suave)">leads migrados con corte del sistema anterior en una sola jornada</p>
        </div>
        <div style="padding:1.5rem 0 1.5rem 1.5rem;border-left:1px solid var(--linea)">
          <div style="font-family:var(--fuente-titulo);color:var(--tinta);font-size:2rem;line-height:1">14</div>
          <p style="margin:.35rem 0 0;font-size:.85rem;color:var(--texto-suave)">locales con <span style="font-family:var(--fuente-mono);font-size:.8rem">hreflang</span> y redirección por idioma del navegador</p>
        </div>
      </div>
    </section>

    <section id="proyectos" style="width:min(100% - 2.5rem,var(--ancho));margin-inline:auto;padding:3.5rem 0">
      <div data-reveal="" style="display:flex;flex-wrap:wrap;gap:1.5rem;align-items:end;justify-content:space-between;margin-bottom:1.75rem">
        <div>
          <p style="font-size:.75rem;letter-spacing:.18em;text-transform:uppercase;color:var(--laton);font-weight:700;margin:0 0 .5rem">Proyectos</p>
          <h2 style="font-family:var(--fuente-titulo);color:var(--tinta);font-size:clamp(1.5rem,3vw,2rem);margin:0">Cuatro trabajos, con sus números.</h2>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:center">
          <span style="font-size:.75rem;color:var(--texto-suave);margin-right:.25rem">Filtrar:</span>
          <button type="button" data-on-click="filtrarTodo" style="cursor:pointer;font-family:var(--fuente-mono);font-size:.72rem;border:1px solid var(--linea);border-radius:100px;padding:.2rem .7rem;background:var(--papel-2);color:var(--texto-suave);transition:all .2s ease;position:relative" class="xc501318"><span style="position:absolute;inset:0;border-radius:100px;background:var(--tinta);opacity:;transition:opacity .2s ease" data-style="position:absolute;inset:0;border-radius:100px;background:var(--tinta);opacity:{fTodo};transition:opacity .2s ease"></span><span style="position:relative;color:" data-style="position:relative;color:{fTodoTxt}">todos</span></button>
          <button type="button" data-on-click="filtrarTs" style="cursor:pointer;font-family:var(--fuente-mono);font-size:.72rem;border:1px solid var(--linea);border-radius:100px;padding:.2rem .7rem;background:var(--papel-2);color:var(--texto-suave);transition:all .2s ease;position:relative" class="xc501318"><span style="position:absolute;inset:0;border-radius:100px;background:var(--tinta);opacity:;transition:opacity .2s ease" data-style="position:absolute;inset:0;border-radius:100px;background:var(--tinta);opacity:{fTs};transition:opacity .2s ease"></span><span style="position:relative;color:" data-style="position:relative;color:{fTsTxt}">TypeScript</span></button>
          <button type="button" data-on-click="filtrarApi" style="cursor:pointer;font-family:var(--fuente-mono);font-size:.72rem;border:1px solid var(--linea);border-radius:100px;padding:.2rem .7rem;background:var(--papel-2);color:var(--texto-suave);transition:all .2s ease;position:relative" class="xc501318"><span style="position:absolute;inset:0;border-radius:100px;background:var(--tinta);opacity:;transition:opacity .2s ease" data-style="position:absolute;inset:0;border-radius:100px;background:var(--tinta);opacity:{fApi};transition:opacity .2s ease"></span><span style="position:relative;color:" data-style="position:relative;color:{fApiTxt}">Integración</span></button>
          <button type="button" data-on-click="filtrarData" style="cursor:pointer;font-family:var(--fuente-mono);font-size:.72rem;border:1px solid var(--linea);border-radius:100px;padding:.2rem .7rem;background:var(--papel-2);color:var(--texto-suave);transition:all .2s ease;position:relative" class="xc501318"><span style="position:absolute;inset:0;border-radius:100px;background:var(--tinta);opacity:;transition:opacity .2s ease" data-style="position:absolute;inset:0;border-radius:100px;background:var(--tinta);opacity:{fData};transition:opacity .2s ease"></span><span style="position:relative;color:" data-style="position:relative;color:{fDataTxt}">Datos</span></button>
        </div>
      </div>

      <div style="display:grid;gap:1.25rem;grid-template-columns:repeat(2,minmax(0,1fr))">

        <div data-if="v1" style="display:contents">
        <article data-reveal="" style="border:1px solid var(--linea);border-radius:var(--radio);background:var(--papel-2);padding:1.5rem;display:flex;flex-direction:column;transition:border-color .2s ease,box-shadow .2s ease" class="xd0b9677">
          <div style="display:flex;align-items:start;justify-content:space-between;gap:1rem;margin-bottom:.6rem">
            <div>
              <div style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;margin-bottom:.35rem">
                <span style="display:inline-flex;align-items:center;gap:.3rem;font-family:var(--fuente-mono);font-size:.65rem;letter-spacing:.06em;text-transform:uppercase;color:#8a6d2f;background:rgba(182,146,77,.14);border:1px solid rgba(182,146,77,.35);border-radius:100px;padding:.1rem .5rem">destacado</span>
                <span style="display:inline-flex;align-items:center;gap:.3rem;font-family:var(--fuente-mono);font-size:.65rem;letter-spacing:.06em;text-transform:uppercase;color:var(--texto-suave);border:1px solid var(--linea);border-radius:100px;padding:.1rem .5rem">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:11px;height:11px"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                  privado
                </span>
              </div>
              <h3 style="font-family:var(--fuente-titulo);color:var(--tinta);font-size:1.2rem;margin:0">Sistema de trading algorítmico</h3>
            </div>
            <span style="font-family:var(--fuente-mono);font-size:.72rem;color:var(--texto-suave);white-space:nowrap">2025 – 2026</span>
          </div>
          <p style="margin:0 0 .9rem;font-size:.9rem;color:var(--texto-suave)">Proyecto propio · Plataforma de decisión automatizada: microservicios en Python, front en React/TypeScript, integración en C# y entrenamiento de modelos en GPU.</p>
          <div style="display:flex;gap:1.5rem;padding:.75rem 0;border-top:1px solid var(--linea);border-bottom:1px solid var(--linea);margin-bottom:.9rem">
            <div><div style="font-family:var(--fuente-titulo);color:var(--tinta);font-size:1.35rem;line-height:1.1">~5.000</div><div style="font-size:.72rem;color:var(--texto-suave)">commits</div></div>
            <div><div style="font-family:var(--fuente-titulo);color:var(--tinta);font-size:1.35rem;line-height:1.1">10 meses</div><div style="font-size:.72rem;color:var(--texto-suave)">a dedicación casi completa</div></div>
          </div>
          <div data-if="a1" style="display:contents">
            <ul style="margin:0 0 .9rem;padding-left:1.1rem;font-size:.88rem;color:var(--texto-suave);display:flex;flex-direction:column;gap:.45rem">
              <li><strong style="color:var(--texto)">Microservicios en Python</strong> con responsabilidades separadas: decisión, riesgo, análisis cuantitativo, aprendizaje y orquestación.</li>
              <li><strong style="color:var(--texto)">Front-end de gestión en React y TypeScript</strong> (Vite), con sistema de diseño propio y aplicación de escritorio empaquetada.</li>
              <li><strong style="color:var(--texto)">Integración en C#</strong> con una plataforma externa de terceros y capa de ejecución sobre puertos dedicados.</li>
              <li><strong style="color:var(--texto)">PostgreSQL</strong> con esquema particionado y control de escritura única por partición.</li>
              <li><strong style="color:var(--texto)">Entrenamiento en GPU</strong>, con ciclo de evaluación y validación reproducible.</li>
            </ul>
            <p style="margin:0 0 .9rem;font-size:.85rem;color:var(--texto-suave);font-style:italic">Repositorio privado por la naturaleza del proyecto. Puedo enseñar el código y la arquitectura en una conversación técnica.</p>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:.3rem;margin-top:auto">
            <span style="font-size:.7rem;font-family:var(--fuente-mono);border:1px solid var(--linea);border-radius:100px;padding:.1rem .55rem;color:var(--texto-suave)">Python</span>
            <span style="font-size:.7rem;font-family:var(--fuente-mono);border:1px solid var(--linea);border-radius:100px;padding:.1rem .55rem;color:var(--texto-suave)">TypeScript</span>
            <span style="font-size:.7rem;font-family:var(--fuente-mono);border:1px solid var(--linea);border-radius:100px;padding:.1rem .55rem;color:var(--texto-suave)">React</span>
            <span style="font-size:.7rem;font-family:var(--fuente-mono);border:1px solid var(--linea);border-radius:100px;padding:.1rem .55rem;color:var(--texto-suave)">C#</span>
            <span style="font-size:.7rem;font-family:var(--fuente-mono);border:1px solid var(--linea);border-radius:100px;padding:.1rem .55rem;color:var(--texto-suave)">PostgreSQL</span>
            <span style="font-size:.7rem;font-family:var(--fuente-mono);border:1px solid var(--linea);border-radius:100px;padding:.1rem .55rem;color:var(--texto-suave)">Docker</span>
            <span style="font-size:.7rem;font-family:var(--fuente-mono);border:1px solid var(--linea);border-radius:100px;padding:.1rem .55rem;color:var(--texto-suave)">GPU</span>
          </div>
          <button type="button" data-on-click="abrir1" style="margin-top:1rem;align-self:start;cursor:pointer;display:inline-flex;align-items:center;gap:.4rem;background:none;border:0;padding:0;font-family:inherit;font-size:.85rem;color:var(--tinta-2)" class="xe210f37"><span data-t="t1"></span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;transition:transform .25s ease;transform:rotate(deg)" data-style="width:14px;height:14px;transition:transform .25s ease;transform:rotate({r1}deg)"><path d="m6 9 6 6 6-6"></path></svg>
          </button>
        </article>
        </div>

        <div data-if="v2" style="display:contents">
        <article data-reveal="" style="border:1px solid var(--linea);border-radius:var(--radio);background:var(--papel-2);padding:1.5rem;display:flex;flex-direction:column;transition:border-color .2s ease,box-shadow .2s ease" class="xd0b9677">
          <div style="display:flex;align-items:start;justify-content:space-between;gap:1rem;margin-bottom:.6rem">
            <div>
