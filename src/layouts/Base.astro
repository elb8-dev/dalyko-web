---
import '../styles/tokens.css';

interface Props {
  titulo: string;
  descripcion: string;
  tipo?: 'website' | 'article';
}

const { titulo, descripcion, tipo = 'website' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://perfil.dalyko.com');
const ref = Astro.url.searchParams.get('ref');

// Datos estructurados: permiten a buscadores y asistentes entender la entidad
// y enlazan con el identificador ORCID, que es verificable.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Eloy R. Becerra Daly',
  jobTitle: 'Desarrollador y consultor de transformación digital',
  url: 'https://perfil.dalyko.com',
  email: 'mailto:daly@icam.es',
  telephone: '+34642568664',
  address: { '@type': 'PostalAddress', addressLocality: 'Pilar de la Horadada', addressRegion: 'Alicante', addressCountry: 'ES' },
  knowsLanguage: ['es', 'en'],
  sameAs: ['https://orcid.org/0009-0008-6684-6726', 'https://github.com/elb8-dev'],
};

const nav = [
  { href: '/', texto: 'Inicio' },
  { href: '/proyectos', texto: 'Proyectos' },
  { href: '/sobre-mi', texto: 'Trayectoria' },
  { href: '/cv', texto: 'CV' },
  { href: '/contacto', texto: 'Contacto' },
];
const enlace = (href: string) => (ref ? `${href}?ref=${encodeURIComponent(ref)}` : href);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content={tipo} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <header class="sitio">
      <nav class="contenedor" aria-label="Principal">
        <a class="marca" href={enlace('/')}>Eloy R. Becerra Daly</a>
        <ul>
          {nav.slice(1).map((i) => (
            <li><a href={enlace(i.href)} aria-current={Astro.url.pathname === i.href ? 'page' : undefined}>{i.texto}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <main class="contenedor">
      <slot />
    </main>

    <footer class="sitio">
      <div class="contenedor">
        <p>
          Eloy R. Becerra Daly · <a href="mailto:daly@icam.es">daly@icam.es</a> · 642 568 664
        </p>
        <p class="meta">
          Astro 7 con renderizado en servidor sobre Google Cloud Run.
          Analítica propia agregada, sin cookies ni seguimiento de personas —
          <a href="/privacidad">cómo trato los datos</a>.
        </p>
      </div>
    </footer>

    {/* Baliza de interacción: una sola medición al abandonar la página.
        No usa cookies ni almacenamiento; envía solo ruta, segundos y scroll. */}
    <script is:inline define:vars={{ ref }}>
      (() => {
        if (navigator.webdriver) return;
        const inicio = Date.now();
        let scrollMax = 0;
        const medir = () => {
          const alto = document.documentElement.scrollHeight - innerHeight;
          const pct = alto > 0 ? Math.round((scrollY / alto) * 100) : 100;
          if (pct > scrollMax) scrollMax = Math.min(pct, 100);
        };
        addEventListener('scroll', medir, { passive: true });
        medir();
        addEventListener('visibilitychange', () => {
          if (document.visibilityState !== 'hidden') return;
          const carga = JSON.stringify({
            ruta: location.pathname,
            ref,
            segundos: Math.round((Date.now() - inicio) / 1000),
            scrollMax,
          });
          navigator.sendBeacon('/api/evento', new Blob([carga], { type: 'application/json' }));
        });
      })();
    </script>
  </body>
</html>
